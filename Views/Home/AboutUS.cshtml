@{
    ViewData["Title"] = "SR Fitness Village_ABOUT-US";
}

<style>
    body {
        padding: 0;
        margin: auto;
    }
    .navigationbar {
        background-color: rgb(65, 218, 65);
    }

        .navigationbar .navbar {
            background-color: rgb(65, 218, 65) !important;
        }

    .about-us {
        text-align: justify;
        font-size: 16px;
        margin: 20px 0;
        line-height: 1.6;
    }

    .ff-secondary {
        font-family: 'Pacifico', cursive;
    }

    /*** Footer ***/
    .footer .btn.btn-social {
        margin-right: 5px;
        width: 35px;
        height: 35px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--light);
        border: 1px solid #FFFFFF;
        border-radius: 35px;
        transition: .3s;
    }

        .footer .btn.btn-social:hover {
            color: var(--primary);
        }

    .footer .btn.btn-link {
        display: block;
        margin-bottom: 5px;
        padding: 0;
        text-align: left;
        color: #FFFFFF;
        font-size: 15px;
        font-weight: normal;
        text-transform: capitalize;
        transition: .3s;
    }

        .footer .btn.btn-link::before {
            position: relative;
            content: "\f105";
            font-family: "Font Awesome 5 Free";
            font-weight: 900;
            margin-right: 10px;
        }

        .footer .btn.btn-link:hover {
            letter-spacing: 1px;
            box-shadow: none;
        }

    .footer .copyright {
        padding: 25px 0;
        font-size: 15px;
        border-top: 1px solid rgba(256, 256, 256, .1);
    }

        .footer .copyright a {
            color: var(--light);
        }

    .footer .footer-menu a {
        margin-right: 15px;
        padding-right: 15px;
        border-right: 1px solid rgba(255, 255, 255, .1);
    }

        .footer .footer-menu a:last-child {
            margin-right: 0;
            padding-right: 0;
            border-right: none;
        }
</style>

<div class="about">
    <!-- About Start -->
    <div class="container-xxl">
        @* <div class="container"> *@
            <div class="row g-5 align-items-center">
                <div class="col-lg-6">
                    <div class="row g-3">
                        <div class="col-6 text-start">
                            <img class="img-fluid rounded w-100 wow zoomIn" data-wow-delay="0.1s" src="~/images/aboutfootball.jpg">
                        </div>
                        <div class="col-6 text-start">
                            <img class="img-fluid rounded w-75 wow zoomIn" data-wow-delay="0.3s" src="~/images/aboutbirthday.webp" style="margin-top: 25%;">
                        </div>
                        <div class="col-6 text-end">
                            <img class="img-fluid rounded w-75 wow zoomIn" data-wow-delay="0.5s" src="~/images/aboutevents.jpg">
                        </div>
                        <div class="col-6 text-end">
                            <img class="img-fluid rounded w-100 wow zoomIn" data-wow-delay="0.7s" src="~/images/aboutcricket.jpg">
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <h5 class="section-title ff-secondary text-start text-primary fw-normal"><span style="font-weight: 700;color: rgb(4, 96, 4);">About Us</span></h5>
                    <h1 class="mb-4">
                        Welcome to <i class="fa fa-ball text-primary me-2"></i>SR Fitness Village
                    </h1>
                    <p class="about-us">Welcome to SR Fitness Village, your ultimate destination for fitness and sports activities. We offer state-of-the-art fitness training, turf booking for cricket and football, and versatile spaces for birthday parties and various events. </p>
                    <p class="about-us">Our facility includes professional cricket nets and football coaching to help athletes of all levels hone their skills. Whether you're looking to improve your game or enjoy a casual match with friends, we have you covered. Our dedicated coaching staff is here to support your journey to excellence. Additionally, our vibrant community space allows fitness enthusiasts and sports lovers to connect and thrive. At SR Fitness Village, we believe in fostering a healthy, active lifestyle and creating memorable experiences for everyone.</p>
                    <p class="about-us">Join us today and become part of our dynamic and supportive community!</p>
                    <div class="row g-4 mb-4">
                        <div class="col-sm-6">
                            <div class="d-flex align-items-center border-start border-5 border-primary px-3">
                                <h1 class="flex-shrink-0 display-5 text-primary mb-0" data-toggle="counter-up">5</h1>
                                <div class="ps-4">
                                    <p class="mb-0">Years of</p>
                                    <h6 class="text-uppercase mb-0">Experience</h6>
                                </div>
                            </div>
                        </div>
                    </div>
                    <a class="btn btn-primary py-3 px-5 mt-2" asp-controller="Home" asp-action="Services">Join Us</a>
                </div>
            </div>
        @* </div> *@
    </div>
    <!-- About End -->
</div>