@{
    ViewData["Title"] = "SR Fitness Village_BOOKING";
}

@model bookingDTO

<style>
    h2 {
        margin-bottom: 20px;
        text-align: center;
        color: #333;
    }

    .form-group {
        margin-bottom: 15px;
    }

    label {
        display: block;
        margin-bottom: 5px;
        color: #333;
    }

    input[type="date"],
    input[type="text"] {
        width: 100%;
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 5px;
        transition: border-color 0.3s ease;
    }

        input[type="date"]:focus,
        input[type="text"]:focus {
            border-color: #007bff;
            outline: none;
        }

    .scroll-box {
        max-height: 100px;
        overflow-y: scroll;
        border: 1px solid #ccc;
        padding: 10px;
        border-radius: 5px;
        background: #f9f9f9;
    }

    button {
        width: 100%;
        padding: 10px;
        background: #007bff;
        border: none;
        border-radius: 5px;
        color: white;
        font-size: 16px;
        cursor: pointer;
        transition: background 0.3s ease;
    }

        button:hover {
            background: #0056b3;
        }

    .error-message {
        color: red;
        font-size: 14px;
        margin-top: 5px;
    }
</style>

<div class="container">
    <h2>Book a Slot</h2>
    <form id="booking-form" method="post" asp-action="Booking" enctype="multipart/form-data">
        <div class="form-group">
            <label for="date">Select Date:</label>
            <input type="date" id="date" name="Date" asp-for="@Model.Date" required>
            <div class="error-message" id="date-error"></div>
        </div>
        <div class="form-group">
            <label for="slots">Select Time Slots (up to 5):</label>
            <div id="slots-container">
                <select id="slots" name="TimeSlots" asp-for="@Model.TimeSlots" multiple required>
                </select>
            </div>
            <div class="error-message" id="slot-error"></div>
        </div>

        <button type="submit">Book Slot</button>
    </form>
    <div class="total-cost" id="total-cost"></div>
</div>

@section Scripts {
    <script>
        document.getElementById('date').addEventListener('change', function () {
            const selectedDate = new Date(this.value);
            const today = new Date();
            today.setHours(0, 0, 0, 0);

            if (selectedDate < today) {
                document.getElementById('date-error').innerText = "Cannot book a slot for a previous date.";
                document.getElementById('slots').innerHTML = "";
            } else {
                document.getElementById('date-error').innerText = "";
                fetchAvailableSlots(this.value);
            }
        });

        function fetchAvailableSlots(date) {
            fetch(`/Home/GetAvailableSlots?date=${date}`)
                .then(response => response.text())
                .then(html => {
                    document.getElementById('slots-container').innerHTML = html;
                })
                .catch(error => console.error('Error fetching slots:', error));
        }
    </script>
}
