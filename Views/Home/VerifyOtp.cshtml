

@{
    ViewData["Title"] = "Verify OTP";
}

@if (TempData["error"] != null)
{
    <div class="alert alert-danger">@TempData["error"]</div>
} 


<div id="otpModal" class="modal">
    <div class="modal-content">
        <span class="close" id="closeOtpModalBtn">&times;</span>
        <h2>Enter OTP</h2>
        <br />
        
        <form id="verifyOtpForm" asp-action="VerifyOtp" method="post">
            <div class="form-group">
                <label for="otp">OTP:</label>
                <br />
                
                <input type="text" id="otp" name="enteredOtp" required class="form-control" />
            </div>
            <br />
            
            <button type="submit" class="btn btn-primary">Verify OTP</button>
            <button type="submit" class="btn btn-primary" asp-action="VerifyOtp">Resend OTP</button>
        </form>
    </div>
</div>

<script>
    function showOtpModal() {
        document.getElementById('otpModal').style.display = 'block';
    }

    document.getElementById('closeOtpModalBtn').addEventListener('click', function () {
        document.getElementById('otpModal').style.display = 'none';
        window.location.href = '@Url.Action("Homesss", "Home")';
    });

    window.onclick = function (event) {
        if (event.target == document.getElementById('otpModal')) {
            document.getElementById('otpModal').style.display = 'none';
        }
    }

    // Automatically show the OTP modal when the page loads
    window.onload = function () {
        showOtpModal();
    }
</script>

<style>
    .modal {
        display: none;
        position: fixed;
        z-index: 1;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: whitesmoke;
        padding-top: 60px;
        transition: opacity 0.3s ease;
    }

    .modal-content {
        background-color: #fff;
        margin: 5% auto;
        padding: 20px;
        border-radius: 10px; 
        box-shadow: 0 5px 15px rgba(14, 179, 190, 0.466);
        width: 90%;
        max-width: 500px;
        animation: slide-down 0.3s ease-out; 
    }

    .close {
        color: #aaa;
        float: right;
        font-size: 24px;
        font-weight: bold;
        cursor: pointer;
        transition: color 0.3s ease; 
    }

    .close:hover,
    .close:focus {
        color: #000; 
        text-decoration: none;
    }


</style>



<script>
    document.addEventListener('DOMContentLoaded', function () {
        sendemail();
    });

    function sendemail() {
        var email = '@ViewBag.Email';
        var from_name = '@ViewBag.Name';
        var generatedOtp = '@ViewBag.Otp';

        console.log('Email:', email);
        console.log('Name:', from_name);
        console.log('OTP:', generatedOtp);

        var templateParams = {
            email: email,
            to_name: from_name,
            message: generatedOtp
        };

        emailjs.send('service_0tmlhlo', 'template_aovoi96', templateParams)
            .then(function (response) {
                console.log('SUCCESS!', response.status, response.text);
                alert("OTP sent successfully!");
            })
            .catch(function (error) {
                console.log('FAILED...', error);
                alert("Failed to send OTP. Please try again.");
            });
    }
</script>

<script type="text/javascript" src="https://cdn.jsdelivr.net/npm/emailjs-com@3/dist/email.min.js"></script>
<script type="text/javascript">
    (function () {
        emailjs.init("VQmtDvJeU7pbVWAwh");
    })();
</script>
