@{
    ViewData["Title"] = "SR Fitness Village_ADMIN_VIEW";
}
@model BookingModel

<div class="container my-5">
    <div class="card">
        <div class="card-header bg-light">
            <ul class="nav nav-tabs fw-bold">
                <li class="nav-item">
                    <a class="nav-link active" id="history-tab" onclick="showTab('history')">History</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="pending-tab" onclick="showTab('pending')">Pending</a>
                </li>
            </ul>
        </div>
        <div class="card-body">
            <div id="history" class="tab-content">
                <h2>History</h2>
                <p>Total Amount Paid: @ViewBag.TotalAmountPaid</p>
                @if (ViewBag.History == null)
                {
                    <p>No bookings found.</p>
                }
                else
                {
                    <table class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Date</th>
                                <th>Time Slots</th>
                                <th>Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var booking in ViewBag.History)
                            {
                                <tr>
                                    <td>@booking.Name</td>
                                    <td>@booking.Email</td>
                                    <td>@booking.Date.ToShortDateString()</td>
                                    <td>@string.Join(", ", booking.TimeSlots)</td>
                                    <td>@booking.Amount</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
            <div id="pending" class="tab-content" style="display:none;">
                <h2>Pending</h2>
                <p>Total Amount Remaining: @ViewBag.TotalAmountRemaining</p>
                @if (ViewBag.Pending == null)
                {
                    <p>No bookings found.</p>
                }
                else
                {
                    <table class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Date</th>
                                <th>Time Slots</th>
                                <th>Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var booking in ViewBag.Pending)
                            {
                                <tr>
                                    <td>@booking.Name</td>
                                    <td>@booking.Email</td>
                                    <td>@booking.Date.ToShortDateString()</td>
                                    <td>@string.Join(", ", booking.TimeSlots)</td>
                                    <td>@booking.Amount</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

<script>
    function showTab(tabName) {
        var historyTab = document.getElementById('history');
        var pendingTab = document.getElementById('pending');
        var historyLink = document.getElementById('history-tab');
        var pendingLink = document.getElementById('pending-tab');

        if (tabName === 'history') {
            historyTab.style.display = 'block';
            pendingTab.style.display = 'none';
            historyLink.classList.add('active');
            pendingLink.classList.remove('active');
        } else if (tabName === 'pending') {
            historyTab.style.display = 'none';
            pendingTab.style.display = 'block';
            historyLink.classList.remove('active');
            pendingLink.classList.add('active');
        }
    }
</script>
